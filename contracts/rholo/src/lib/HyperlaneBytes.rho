// Big-endian integer <-> byte-array helpers for Hyperlane message encoding.
//
// Rholang has no integer-to-byte constructor, but it has a 256-entry hex literal,
// `hexToBytes`, `slice`, `nth`, `++`, and the integer shift/bitwise ops. Building the
// byte table once from a literal and slicing one byte at a time keeps the encoding
// deterministic and identical to `abi.encodePacked(uint32)`.
//
// Preconditions: uint helpers are called with non-negative, in-range values. Every
// field of a dispatched message is range-checked before it reaches them.

contract byteAt(@value, ret) = {
  match "".hexToBytes().slice(value, value + 1) {
    byte => { ret!(byte) }
  }
} |

contract bytesOf(@values, @i, @acc, ret) = {
  if (i >= values.length()) {
    ret!(acc)
  } else {
    new bCh in {
      byteAt!(values.nth(i), *bCh) |
      for (@b <- bCh) {
        bytesOf!(values, i + 1, acc ++ b, *ret)
      }
    }
  }
} |

contract uint32ToBytes(@value, ret) = {
  bytesOf!([
    (value / 16777216) % 256,
    (value / 65536) % 256,
    (value / 256) % 256,
    value % 256
  ], 0, "".hexToBytes(), *ret)
} |

contract bytesToUint32(@bytes, ret) = {
  ret!(bytes.nth(0) * 16777216 + bytes.nth(1) * 65536 + bytes.nth(2) * 256 + bytes.nth(3))
} |

contract uint48ToBytes(@value, ret) = {
  bytesOf!([
    (value / 1099511627776) % 256,
    (value / 4294967296) % 256,
    (value / 16777216) % 256,
    (value / 65536) % 256,
    (value / 256) % 256,
    value % 256
  ], 0, "".hexToBytes(), *ret)
} |

contract bytesToUint48(@bytes, ret) = {
  ret!(bytes.nth(0) * 1099511627776 + bytes.nth(1) * 4294967296 + bytes.nth(2) * 16777216
     + bytes.nth(3) * 65536 + bytes.nth(4) * 256 + bytes.nth(5))
} |
