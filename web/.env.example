# rholo public HTTP API
VITE_RBRIDGE_NODE=http://localhost:40403
# Installed bridge URI from .devnet/bridge.json
VITE_RBRIDGE_URI=
# Anvil vault address from .devnet/evm.json
VITE_RBRIDGE_VAULT=
# Mock USDT token address from .devnet/evm.json (enables the ERC-20 approve/lock)
VITE_RBRIDGE_USDT=
# TVM vault address (base58) and TRC-20 USDT (enables the TronLink approve/lock)
VITE_RBRIDGE_TRON_VAULT=
VITE_RBRIDGE_TRON_USDT=
# Devnet rholo address to read balances for (demo keys; dev only)
VITE_RHOLO_ADDRESS=
# Local Anvil RPC
VITE_ANVIL_RPC=http://127.0.0.1:8545
